#!/usr/bin/env bash
# Abhaile GitOps Runner — outer reconciliation loop.
# Fetches repository state, renders, applies, and tracks success.
# See: docs/specs/accepted/0028-target-host-reconciliation-model.md
set -euo pipefail

readonly ABHAILE_BRANCH="${ABHAILE_BRANCH:-main}"
readonly ABHAILE_REMOTE="${ABHAILE_REMOTE:-origin}"
readonly ABHAILE_OUTPUT="${ABHAILE_OUTPUT:-/var/lib/abhaile}"
readonly ABHAILE_VENV_BIN="${ABHAILE_VENV_BIN:-${PWD}/.venv/bin}"
readonly ABHAILE_PYTHON="${ABHAILE_PYTHON:-${ABHAILE_VENV_BIN}/python}"
readonly ABHAILE_SRC="${ABHAILE_SRC:-${PWD}/src}"
readonly ABHAILE_GIT_SSH_KEY="${ABHAILE_GIT_SSH_KEY:-/home/abhaile/.ssh/gitops_ed25519}"
readonly ABHAILE_GIT_KNOWN_HOSTS="${ABHAILE_GIT_KNOWN_HOSTS:-/home/abhaile/.ssh/known_hosts}"
ABHAILE_VERBOSE="${ABHAILE_VERBOSE:-0}"
readonly RUNNER_STATE_DIR="${ABHAILE_OUTPUT}/runner"
readonly LOCK_FILE="${RUNNER_STATE_DIR}/lock"
readonly LAST_STATUS_FILE="${RUNNER_STATE_DIR}/last-run-status"
readonly LAST_SUMMARY_FILE="${RUNNER_STATE_DIR}/last-run-summary"
readonly ABHAILE_FORCE_RETRY="${ABHAILE_FORCE_RETRY:-0}"
readonly ABHAILE_FORCE_FULL="${ABHAILE_FORCE_FULL:-0}"
readonly ABHAILE_FULL_RECONCILE_INTERVAL_SECONDS="${ABHAILE_FULL_RECONCILE_INTERVAL_SECONDS:-}"
readonly ABHAILE_RENDER="${ABHAILE_VENV_BIN}/abhaile-render"
readonly ABHAILE_INTEGRITY="${ABHAILE_VENV_BIN}/abhaile-integrity"
readonly ABHAILE_ANSIBLE_PLAYBOOK="${ABHAILE_ANSIBLE_PLAYBOOK:-/usr/bin/ansible-playbook}"
readonly ABHAILE_ANSIBLE_CONFIG="${ABHAILE_ANSIBLE_CONFIG:-${PWD}/ansible/ansible.cfg}"
readonly ABHAILE_RECONCILE_PLAYBOOK="${ABHAILE_RECONCILE_PLAYBOOK:-${PWD}/ansible/playbooks/reconcile.yml}"
readonly ABHAILE_NETWORK_RESTORE_PLAYBOOK="${ABHAILE_NETWORK_RESTORE_PLAYBOOK:-${PWD}/ansible/playbooks/restore-network.yml}"
readonly ABHAILE_HEALTH="${ABHAILE_VENV_BIN}/abhaile-health"
readonly ABHAILE_CLUSTER_HEALTH="${ABHAILE_CLUSTER_HEALTH:-0}"
RUN_STARTED_AT=""
RUN_STARTED_SECONDS=""
CURRENT_PHASE="start"
RECOVERED_LAST_SUCCESSFUL=0
RUN_CONTEXT_DIR=""
RUN_TRIGGER="unknown"
RUN_LAST_FULL_AGE="none"
RUN_FULL_INTERVAL="21600"
RUN_INTERVAL_STATUS="valid"
FAST_DEADLINE_SECONDS=""
SCHEDULE_DECISION="due"
SCHEDULE_POSTCHECK="none"
AUDIT_ENTRY_COUNT="none"
AUDIT_DURATION_SECONDS="none"
AUDIT_DRIFT_COUNT="none"
AUDIT_UNCERTAINTY_COUNT="none"
AUDIT_PATH_SAMPLE="none"
RUN_POST_FULL_OUTCOME="none"

export PYTHONPATH="${ABHAILE_SRC}${PYTHONPATH:+:${PYTHONPATH}}"

log() { printf '[abhaile-runner] %s\n' "$*"; }
die() { log "FATAL: $*"; exit 1; }

# --- State helpers -----------------------------------------------------------

write_atomic() {
    local dest="$1" content="$2"
    local tmp="${dest}.tmp"
    printf '%s\n' "$content" > "$tmp"
    sync "$tmp"
    mv "$tmp" "$dest"
}

record_run_status() {
    local exit_code="$1" commit="${2:-unknown}"
    local ts
    ts="$(date --iso-8601=seconds)"
    write_atomic "$LAST_STATUS_FILE" "${exit_code} ${ts} ${commit}"
}

record_run_summary() {
    local exit_code="$1" phase="$2" outcome="$3" target_sha="${4:-unknown}" rollback="${5:-false}"
    local ts duration current_sha last_good_sha
    ts="$(date --iso-8601=seconds)"
    current_sha="$(git rev-parse HEAD 2>/dev/null || printf 'unknown')"
    last_good_sha="$(read_last_good_sha || true)"
    duration="unknown"
    if [[ -n "$RUN_STARTED_SECONDS" ]]; then
        duration="$(($(date +%s) - RUN_STARTED_SECONDS))"
    fi

    write_atomic "$LAST_SUMMARY_FILE" "host=$(hostname -s)
branch=${ABHAILE_BRANCH}
remote=${ABHAILE_REMOTE}
started_at=${RUN_STARTED_AT:-unknown}
finished_at=${ts}
duration_seconds=${duration}
phase=${phase}
outcome=${outcome}
exit_code=${exit_code}
current_sha=${current_sha}
target_sha=${target_sha}
last_good_sha=${last_good_sha:-none}
rollback_attempted=${rollback}
trigger=${RUN_TRIGGER}
last_full_age_seconds=${RUN_LAST_FULL_AGE}
full_interval_seconds=${RUN_FULL_INTERVAL}
interval_status=${RUN_INTERVAL_STATUS}
audit_entry_count=${AUDIT_ENTRY_COUNT}
audit_duration_seconds=${AUDIT_DURATION_SECONDS}
audit_drift_count=${AUDIT_DRIFT_COUNT}
audit_uncertainty_count=${AUDIT_UNCERTAINTY_COUNT}
audit_path_sample=${AUDIT_PATH_SAMPLE}
post_full_outcome=${RUN_POST_FULL_OUTCOME}"
}

record_network_restore_noop_summary() {
    local last_good_sha="${1:-}" ts duration
    ts="$(date --iso-8601=seconds)"
    duration="$(($(date +%s) - RUN_STARTED_SECONDS))"
    write_atomic "$LAST_SUMMARY_FILE" "host=$(hostname -s)
branch=${ABHAILE_BRANCH}
remote=${ABHAILE_REMOTE}
started_at=${RUN_STARTED_AT}
finished_at=${ts}
duration_seconds=${duration}
phase=network-restore
outcome=not-required
exit_code=0
current_sha=unknown
target_sha=${last_good_sha:-unknown}
last_good_sha=${last_good_sha:-none}
rollback_attempted=false"
}

read_restore_record() {
    local path="$1" allow_legacy="$2" payload
    if [[ ! -e "$path" && ! -L "$path" ]]; then
        return 0
    fi
    if [[ ! -f "$path" || -L "$path" ]]; then
        printf 'runner state error: Runner state record is not a regular file: %s\n' \
            "${path##*/}" >&2
        return 2
    fi
    if ! payload="$(<"$path")"; then
        printf 'runner state error: Unable to read runner state record: %s\n' \
            "${path##*/}" >&2
        return 2
    fi
    if [[ "$allow_legacy" == "true" ]]; then
        if [[ "$payload" =~ ^([0-9a-f]{40})([[:space:]].*)?$ ]]; then
            printf '%s' "${BASH_REMATCH[1]}"
            return 0
        fi
    elif [[ "$payload" =~ ^[0-9a-f]{40}$ ]]; then
        printf '%s' "$payload"
        return 0
    fi
    printf 'runner state error: Invalid %s commit SHA\n' "${path##*/}" >&2
    return 2
}

network_restore_admission() {
    local current last_good
    current="$(read_restore_record "${RUNNER_STATE_DIR}/current-run" false)" || return $?
    last_good="$(read_restore_record "${RUNNER_STATE_DIR}/last-successful-commit" true)" \
        || return $?
    if [[ -z "$current" || "$current" == "$last_good" ]]; then
        printf 'not-required:%s\n' "$last_good"
    else
        printf 'restore-required:%s\n' "$last_good"
    fi
}

record_current_phase() { CURRENT_PHASE="$1"; }

read_current_phase() { printf '%s' "$CURRENT_PHASE"; }

state_call() {
    local operation="$1"
    shift
    "$ABHAILE_PYTHON" -c "
from pathlib import Path
import sys
from abhaile.state import reconciliation
from abhaile.utils.errors import ApplyError
operation = getattr(reconciliation, sys.argv[1])
try:
    result = operation(Path(sys.argv[2]), *sys.argv[3:])
except ApplyError as exc:
    print(f'runner state error: {exc}', file=sys.stderr)
    raise SystemExit(2) from None
if result is not None:
    print(result)
" "$operation" "$RUNNER_STATE_DIR" "$@"
}

read_failed_target_sha() { state_call read_failed_target; }

record_failed_target() { state_call mark_failed_target "$1"; }

read_last_good_sha() { state_call read_last_successful; }

read_current_run_sha() { state_call read_current_run; }

classify_startup_state() { state_call classify_startup; }

mark_mutation() { state_call mark_current_run "$1"; }

read_full_schedule() {
    state_call full_reconciliation_schedule \
        "$1" "$ABHAILE_FULL_RECONCILE_INTERVAL_SECONDS" "$ABHAILE_FORCE_FULL"
}

record_last_full() { state_call record_last_full_reconciliation "$1" "$2"; }

degraded_repair_is_deferred() {
    [[ "$(state_call should_defer_degraded_repair "$1")" == "True" ]]
}

commit_success() {
    local sha="$1" clear_failed="${2:-true}" failed_sha=""
    if [[ "$clear_failed" == "true" ]]; then
        failed_sha="$(read_failed_target_sha)"
    fi
    state_call commit_last_successful "$sha"
    if [[ -n "$failed_sha" ]]; then
        state_call clear_matching_failed_target "$failed_sha"
    fi
}

# --- Validation --------------------------------------------------------------

validate_host() {
    local host="$1"
    if ! "$ABHAILE_PYTHON" -c "
import yaml, sys
m = yaml.safe_load(open('config/mapping.yaml'))
hosts = [k for item in m.get('abhaile', []) for k in item]
sys.exit(0 if '$host' in hosts else 1)
" 2>/dev/null; then
        log "Host '${host}' not found in config/mapping.yaml"
        record_run_status 3 "unknown"
        record_run_summary 3 "validate_host" "failure"
        exit 3
    fi
}

check_worktree_clean() {
    if [[ -n "$(git status --porcelain)" ]]; then
        log "Dirty worktree detected; operator intervention required"
        log "dirty status:"
        git status --short || true
        log "dirty staged changes:"
        git diff --cached --name-status || true
        log "dirty unstaged changes:"
        git diff --name-status || true
        log "recent git reflog:"
        git reflog -n 5 --date=iso || true
        record_run_status 3 "unknown"
        record_run_summary 3 "check_worktree_clean" "dirty-worktree"
        exit 3
    fi
}

# --- Pipeline steps ----------------------------------------------------------

do_fetch() {
    record_current_phase "fetch"
    log "fetch: ${ABHAILE_REMOTE}/${ABHAILE_BRANCH}"
    [[ -f "$ABHAILE_GIT_SSH_KEY" ]] || {
        log "fetch: deploy key is unavailable"
        return 1
    }
    [[ -s "$ABHAILE_GIT_KNOWN_HOSTS" ]] || {
        log "fetch: pinned known_hosts is unavailable"
        return 1
    }
    export GIT_SSH_COMMAND="ssh -i ${ABHAILE_GIT_SSH_KEY} -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=${ABHAILE_GIT_KNOWN_HOSTS}"
    /usr/bin/timeout --signal=KILL 15s \
        git fetch --prune "$ABHAILE_REMOTE" "$ABHAILE_BRANCH"
}

do_checkout() {
    local target_sha="$1"
    record_current_phase "checkout" "$target_sha"

    local current_sha
    current_sha="$(git rev-parse HEAD)"
    log "checkout: fast-forward current=${current_sha:0:12} target=${target_sha:0:12}"
    if ! git merge-base --is-ancestor "$current_sha" "$target_sha" 2>/dev/null; then
        log "Cannot fast-forward: current HEAD is not an ancestor of target"
        record_run_status 1 "$target_sha"
        record_run_summary 1 "checkout" "fast-forward-failure" "$target_sha"
        exit 1
    fi

    git merge --ff-only --quiet "$target_sha"
}

do_render() {
    local host="$1" output_root="$2"
    local verbose_flag=""
    [ "$ABHAILE_VERBOSE" -ge 1 ] 2>/dev/null && verbose_flag="-v"
    [ "$ABHAILE_VERBOSE" -ge 2 ] 2>/dev/null && verbose_flag="-vv"
    record_current_phase "render"
    log "render: host=${host} output=${output_root}"
    "$ABHAILE_RENDER" --host "$host" --output "$output_root" $verbose_flag
}

do_render_bounded() {
    local host="$1" output_root="$2" remaining verbose_flag=""
    [ "$ABHAILE_VERBOSE" -ge 1 ] 2>/dev/null && verbose_flag="-v"
    [ "$ABHAILE_VERBOSE" -ge 2 ] 2>/dev/null && verbose_flag="-vv"
    remaining="$(remaining_fast_seconds)" || return 124
    record_current_phase "render"
    log "render: host=${host} output=${output_root}"
    /usr/bin/timeout --signal=KILL "${remaining}s" \
        "$ABHAILE_RENDER" --host "$host" --output "$output_root" $verbose_flag
}

remaining_fast_seconds() {
    if [[ -z "$FAST_DEADLINE_SECONDS" ]]; then
        printf '60'
        return 0
    fi
    local remaining="$((FAST_DEADLINE_SECONDS - $(date +%s)))"
    ((remaining > 0)) || return 1
    printf '%s' "$remaining"
}

do_integrity() {
    local host="$1" output_root="$2" scope="$3" remaining limit result_file started status=0
    remaining="$(remaining_fast_seconds)" || return 124
    limit=10
    ((remaining < limit)) && limit="$remaining"
    record_current_phase "integrity-${scope}"
    log "integrity: scope=${scope} output=${output_root}"
    result_file="${RUN_CONTEXT_DIR}/integrity-${scope}.json"
    started="$(date +%s)"
    # The unprivileged runner intentionally owns this diagnostic capture file.
    # shellcheck disable=SC2024
    sudo /usr/bin/timeout --signal=KILL "${limit}s" \
        "$ABHAILE_INTEGRITY" --output "${output_root}" --host "$host" --scope "$scope" --json \
        > "$result_file" || status=$?
    if [[ -s "$result_file" ]]; then
        cat "$result_file"
    fi
    if [[ "$scope" == "ordinary" && -s "$result_file" ]]; then
        local parsed
        if ! parsed="$("$ABHAILE_PYTHON" -c '
import json, sys
value = json.load(open(sys.argv[1], encoding="utf-8"))
paths = value.get("paths", [])
if not isinstance(paths, list) or len(paths) > 10:
    raise SystemExit(1)
sample = ",".join(paths) or "none"
sample = "".join(character if character.isprintable() else "?" for character in sample)
print(value["entries"], value["drift"], value["uncertainty"], sample, sep="\t")
' "$result_file")"; then
            return 1
        fi
        IFS=$'\t' read -r AUDIT_ENTRY_COUNT AUDIT_DRIFT_COUNT AUDIT_UNCERTAINTY_COUNT AUDIT_PATH_SAMPLE \
            <<< "$parsed"
        AUDIT_DURATION_SECONDS="$(($(date +%s) - started))"
    fi
    return "$status"
}

do_actionable_health() {
    local output_root="$1" remaining limit
    remaining="$(remaining_fast_seconds)" || return 124
    limit=30
    ((remaining < limit)) && limit="$remaining"
    record_current_phase "actionable-health"
    log "actionable-health: output=${output_root}"
    sudo /usr/bin/timeout --signal=KILL "${limit}s" \
        "$ABHAILE_HEALTH" --profile local-actionable --output "$output_root"
}

write_ansible_vars() {
    local host="$1" rendered_root="$2" destination="$3"
    local desired_manifest="${4:-}" removal_source_manifest="${5:-}"
    local cleanup_scope="${6:-all}"
    "$ABHAILE_PYTHON" -c '
import json
from pathlib import Path
import sys

from abhaile.plan.diff import classify_manifest_removals

host, rendered_root, config_root, destination, desired, removal_source, cleanup_scope = sys.argv[1:]
cleanup = []
if desired and removal_source:
    included_kinds = None
    network_kinds = {"networkd.netdev", "networkd.network", "networkd.dropin"}
    if cleanup_scope == "network":
        included_kinds = network_kinds
    elif cleanup_scope != "all":
        raise SystemExit(f"Unsupported cleanup scope: {cleanup_scope}")
    classification = classify_manifest_removals(
        Path(desired),
        Path(removal_source),
        included_kinds=included_kinds,
        directory_residue_kinds={"networkd.dropin", "service.directory"},
        file_residue_kinds={"caddy.config", "host.packages"},
    )
    if classification["blocked"]:
        blocked = ", ".join(
            "{} ({})".format(item["target_path"], item["reason"])
            for item in classification["blocked"]
        )
        raise SystemExit(f"Managed removal is blocked: {blocked}")
    cleanup = classification["identity_matches"]

payload = {
    "abhaile_rendered_root": str(Path(rendered_root).resolve() / "rendered"),
    "abhaile_config_root": str(Path(config_root).resolve()),
    "abhaile_expected_host": host,
    "abhaile_candidate_cleanup_entries": cleanup,
}
Path(destination).write_text(json.dumps(payload, sort_keys=True) + "\n", encoding="utf-8")
' "$host" "$rendered_root" "${PWD}/config" "$destination" "$desired_manifest" "$removal_source_manifest" "$cleanup_scope"
}

do_ansible_check() {
    local vars_file="$1" playbook="${2:-$ABHAILE_RECONCILE_PLAYBOOK}"
    local verbose_flag=""
    [ "$ABHAILE_VERBOSE" -ge 1 ] 2>/dev/null && verbose_flag="-v"
    [ "$ABHAILE_VERBOSE" -ge 2 ] 2>/dev/null && verbose_flag="-vv"
    record_current_phase "ansible-check"
    log "ansible-check: playbook=${playbook}"
    sudo /usr/bin/env ANSIBLE_CONFIG="$ABHAILE_ANSIBLE_CONFIG" \
        "$ABHAILE_ANSIBLE_PLAYBOOK" --inventory localhost, --connection local --check \
        --extra-vars "@${vars_file}" $verbose_flag "$playbook"
}

do_ansible_apply() {
    local vars_file="$1" playbook="${2:-$ABHAILE_RECONCILE_PLAYBOOK}"
    local verbose_flag=""
    [ "$ABHAILE_VERBOSE" -ge 1 ] 2>/dev/null && verbose_flag="-v"
    [ "$ABHAILE_VERBOSE" -ge 2 ] 2>/dev/null && verbose_flag="-vv"
    record_current_phase "ansible-apply"
    log "ansible-apply: playbook=${playbook}"
    sudo /usr/bin/env ANSIBLE_CONFIG="$ABHAILE_ANSIBLE_CONFIG" \
        "$ABHAILE_ANSIBLE_PLAYBOOK" --inventory localhost, --connection local \
        --extra-vars "@${vars_file}" --extra-vars '{"abhaile_live_apply":true}' \
        $verbose_flag "$playbook"
}

do_cluster_health() {
    local verbose_flag=""
    [ "$ABHAILE_VERBOSE" -ge 1 ] 2>/dev/null && verbose_flag="-v"
    [ "$ABHAILE_VERBOSE" -ge 2 ] 2>/dev/null && verbose_flag="-vv"

    if [[ "$ABHAILE_CLUSTER_HEALTH" != "1" ]]; then
        return 0
    fi

    record_current_phase "cluster-health"
    log "cluster-health: output=${ABHAILE_OUTPUT}"
    if ! sudo "$ABHAILE_HEALTH" --output "$ABHAILE_OUTPUT" --cluster $verbose_flag; then
        log "cluster-health: non-fatal audit failed; local host state remains accepted"
    fi
}

run_pipeline_for_checked_out_commit() {
    local host="$1" target_sha="$2" rendered_root="$3"
    local desired_manifest="${4:-}" removal_source_manifest="${5:-}"
    local mutation_sha="${6-$target_sha}"
    local vars_file="${rendered_root}/ansible-vars.json"
    do_render "$host" "$rendered_root" \
        && write_ansible_vars "$host" "$rendered_root" "$vars_file" \
            "$desired_manifest" "$removal_source_manifest" \
        && do_ansible_check "$vars_file" \
        && { [[ -z "$mutation_sha" ]] || mark_mutation "$mutation_sha"; } \
        && do_ansible_apply "$vars_file" \
        && do_cluster_health
}

return_to_branch() {
    log "returning worktree to ${ABHAILE_BRANCH}"
    git checkout --quiet "$ABHAILE_BRANCH" 2>/dev/null \
        || git checkout --quiet "${ABHAILE_REMOTE}/${ABHAILE_BRANCH}" 2>/dev/null \
        || true
}

recover_last_successful() {
    local host="$1" interrupted_sha="${2:-}" preserve_failed="${3:-true}"
    local last_good_sha original_marker candidate_root last_successful_root candidate_manifest=""
    last_good_sha="$(read_last_good_sha)"
    original_marker="$(read_current_run_sha)"
    record_current_phase "recovery"

    if [[ -z "$last_good_sha" ]]; then
        log "recovery: no last-successful commit; explicit enrollment is required"
        return 2
    fi

    if ! git cat-file -e "${last_good_sha}^{commit}" 2>/dev/null; then
        log "recovery: commit ${last_good_sha:0:12} is unavailable locally"
        return 2
    fi

    if [[ -n "$interrupted_sha" && "$interrupted_sha" != "$last_good_sha" ]]; then
        record_failed_target "$interrupted_sha"
    fi

    if [[ -n "$interrupted_sha" && "$interrupted_sha" != "$last_good_sha" ]]; then
        if ! git cat-file -e "${interrupted_sha}^{commit}" 2>/dev/null; then
            log "recovery: interrupted commit ${interrupted_sha:0:12} is unavailable locally"
            return 2
        fi
        candidate_root="${RUN_CONTEXT_DIR}/recovery-candidate"
        log "recovery: rendering interrupted candidate ${interrupted_sha:0:12} for cleanup proof"
        git checkout --quiet "$interrupted_sha"
        validate_host "$host"
        do_render "$host" "$candidate_root" || return 1
        candidate_manifest="${candidate_root}/rendered/manifest.json"
    fi

    log "recovery: reconciling last-successful ${last_good_sha:0:12}"
    git checkout --quiet "$last_good_sha"
    validate_host "$host"
    last_successful_root="${RUN_CONTEXT_DIR}/recovery-last-successful"

    local recovery_marker="$last_good_sha" marker_to_clear="$last_good_sha"
    if [[ -n "$original_marker" ]]; then
        if [[ "$original_marker" != "$interrupted_sha" ]]; then
            log "recovery: current-run changed before accepted reconciliation"
            return 2
        fi
        recovery_marker=""
        marker_to_clear="$original_marker"
    fi
    if run_pipeline_for_checked_out_commit "$host" "$last_good_sha" "$last_successful_root" \
        "${last_successful_root}/rendered/manifest.json" "$candidate_manifest" \
        "$recovery_marker"; then
        state_call clear_matching_current_run "$marker_to_clear"
        if [[ "$preserve_failed" != "true" ]]; then
            local failed_sha
            failed_sha="$(read_failed_target_sha)"
            if [[ -n "$failed_sha" ]]; then
                state_call clear_matching_failed_target "$failed_sha"
            fi
        fi
        log "recovery: SUCCESS — host reconciled to ${last_good_sha:0:12}"
        return 0
    else
        log "recovery: FAILED — last-successful reconciliation did not pass"
        return 1
    fi
}

restore_last_successful_network() {
    local host="$1" last_good_sha interrupted_sha candidate_root last_successful_root candidate_manifest=""
    last_good_sha="$(read_last_good_sha)"
    interrupted_sha="$(read_current_run_sha)"
    record_current_phase "network-restore"

    if [[ -z "$last_good_sha" ]]; then
        log "network-restore: no last-successful commit; explicit enrollment is required"
        return 2
    fi
    if ! git cat-file -e "${last_good_sha}^{commit}" 2>/dev/null; then
        log "network-restore: last-successful commit ${last_good_sha:0:12} is unavailable locally"
        return 2
    fi

    if [[ -n "$interrupted_sha" && "$interrupted_sha" != "$last_good_sha" ]]; then
        if ! git cat-file -e "${interrupted_sha}^{commit}" 2>/dev/null; then
            log "network-restore: interrupted commit ${interrupted_sha:0:12} is unavailable locally"
            return 2
        fi
        candidate_root="${RUN_CONTEXT_DIR}/network-candidate"
        git checkout --quiet "$interrupted_sha"
        validate_host "$host"
        do_render "$host" "$candidate_root" || return 1
        candidate_manifest="${candidate_root}/rendered/manifest.json"
    fi

    last_successful_root="${RUN_CONTEXT_DIR}/network-last-successful"
    git checkout --quiet "$last_good_sha"
    validate_host "$host"
    do_render "$host" "$last_successful_root" || return 1
    write_ansible_vars "$host" "$last_successful_root" \
        "${last_successful_root}/ansible-vars.json" \
        "${last_successful_root}/rendered/manifest.json" "$candidate_manifest" "network" || return 1
    do_ansible_check "${last_successful_root}/ansible-vars.json" \
        "$ABHAILE_NETWORK_RESTORE_PLAYBOOK" \
        || return 1
    do_ansible_apply "${last_successful_root}/ansible-vars.json" \
        "$ABHAILE_NETWORK_RESTORE_PLAYBOOK"
}

load_full_schedule() {
    local sha="$1" decision trigger interval validity age postcheck
    read -r decision trigger interval validity age postcheck <<< "$(read_full_schedule "$sha")"
    SCHEDULE_DECISION="$decision"
    SCHEDULE_POSTCHECK="$postcheck"
    RUN_TRIGGER="$trigger"
    RUN_FULL_INTERVAL="$interval"
    RUN_INTERVAL_STATUS="$validity"
    RUN_LAST_FULL_AGE="$age"
}

record_completed_full() {
    local host="$1" sha="$2" candidate_root="$3" success_outcome="$4"
    local foundation_clean=1 ordinary_clean=1
    FAST_DEADLINE_SECONDS=""
    do_integrity "$host" "$candidate_root" enrollment-foundations || foundation_clean=0
    do_integrity "$host" "$candidate_root" ordinary || ordinary_clean=0
    do_actionable_health "$candidate_root" || ordinary_clean=0
    local postcheck="degraded"
    [[ "$ordinary_clean" == "1" ]] && postcheck="clean"
    if ! record_last_full "$sha" "$postcheck"; then
        RUN_POST_FULL_OUTCOME="failure"
        log "post-full: unable to publish full-reconciliation scheduling evidence"
        record_run_status 1 "$sha"
        record_run_summary 1 "post-full" "failure" "$sha" "false"
        return 1
    fi
    if [[ "$foundation_clean" != "1" ]]; then
        RUN_POST_FULL_OUTCOME="degraded-enrollment-foundation"
        log "post-full: enrollment foundations require bootstrap or adoption"
        record_run_status 1 "$sha"
        record_run_summary 1 "post-full" "degraded-enrollment-foundation" "$sha" "false"
        return 1
    fi
    if [[ "$ordinary_clean" != "1" ]]; then
        RUN_POST_FULL_OUTCOME="degraded-post-full"
        log "post-full: ordinary integrity or actionable health remains degraded"
        record_run_status 1 "$sha"
        record_run_summary 1 "post-full" "degraded-post-full" "$sha" "false"
        return 1
    fi
    if [[ "$RUN_INTERVAL_STATUS" == "invalid" ]]; then
        RUN_POST_FULL_OUTCOME="degraded-invalid-full-interval"
        log "schedule: invalid full interval; using safe six-hour default"
        record_run_status 1 "$sha"
        record_run_summary 1 "schedule" "degraded-invalid-full-interval" "$sha" "false"
        return 1
    fi
    record_run_status 0 "$sha"
    RUN_POST_FULL_OUTCOME="clean"
    record_run_summary 0 "complete" "$success_outcome" "$sha" "false"
}

finish_fast_result() {
    local sha="$1" outcome="$2" exit_code="0"
    if [[ "$RUN_INTERVAL_STATUS" == "invalid" ]]; then
        log "schedule: invalid full interval; using safe six-hour default"
        outcome="degraded-invalid-full-interval"
        exit_code="1"
    fi
    record_run_status "$exit_code" "$sha"
    record_run_summary "$exit_code" "fast-path" "$outcome" "$sha" "false"
    return_to_branch
    return "$exit_code"
}

# --- Main --------------------------------------------------------------------

main() {
    local host mode="reconcile"
    if [[ $# -gt 1 ]]; then
        die "usage: abhaile-runner [--restore-network]"
    fi
    if [[ $# -eq 1 ]]; then
        [[ "$1" == "--restore-network" ]] || die "usage: abhaile-runner [--restore-network]"
        mode="restore-network"
    fi
    host="$(hostname -s)"
    RUN_STARTED_AT="$(date --iso-8601=seconds)"
    RUN_STARTED_SECONDS="$(date +%s)"

    # Ensure state directory exists with correct ownership
    mkdir -p "$RUNNER_STATE_DIR"
    chmod 0750 "$RUNNER_STATE_DIR"

    # Acquire lock (non-blocking)
    exec 9>"$LOCK_FILE"
    if ! flock -n 9; then
        log "lock: another run is active; exiting"
        exit 2
    fi

    log "start: host=${host} branch=${ABHAILE_BRANCH} remote=${ABHAILE_REMOTE} cwd=${PWD}"
    record_current_phase "start"

    if [[ "$ABHAILE_FORCE_FULL" != "0" && "$ABHAILE_FORCE_FULL" != "1" ]]; then
        log "FATAL: ABHAILE_FORCE_FULL must be 0 or 1"
        record_run_status 1 "unknown"
        record_run_summary 1 "validate" "failure" "unknown" "false"
        exit 1
    fi

    if [[ "$mode" == "restore-network" ]]; then
        local admission last_network_sha
        admission="$(network_restore_admission)" || exit $?
        if [[ "$admission" == not-required:* ]]; then
            last_network_sha="${admission#not-required:}"
            log "network-restore: no interrupted mutation; allowing normal network startup"
            record_run_status 0 "${last_network_sha:-unknown}"
            record_network_restore_noop_summary "$last_network_sha"
            exit 0
        fi
    fi

    RUN_CONTEXT_DIR="$(mktemp -d "${RUNNER_STATE_DIR}/run.XXXXXX")"
    trap 'if [[ -n "$RUN_CONTEXT_DIR" && "$RUN_CONTEXT_DIR" == "${RUNNER_STATE_DIR}"/run.* ]]; then rm -rf -- "$RUN_CONTEXT_DIR"; fi' EXIT

    if [[ "$mode" == "restore-network" ]]; then
        local last_network_sha
        check_worktree_clean
        log "network-restore: enforcing retained last-successful network files"
        if restore_last_successful_network "$host"; then
            return_to_branch
            record_run_status 0 "$(read_last_good_sha)"
            record_run_summary 0 "network-restore" "success" "$(read_last_good_sha)" "false"
            exit 0
        fi
        return_to_branch
        record_run_status 1 "$(read_last_good_sha || true)"
        record_run_summary 1 "network-restore" "failure" "$(read_last_good_sha || true)" "false"
        exit 1
    fi

    check_worktree_clean

    local startup_action interrupted_sha last_sha
    startup_action="$(classify_startup_state)"
    interrupted_sha="$(read_current_run_sha)"
    last_sha="$(read_last_good_sha)"
    case "$startup_action" in
        enrollment-required)
            log "startup: no last-successful commit; explicit enrollment is required"
            record_run_status 1 "unknown"
            record_run_summary 1 "startup" "enrollment-required"
            exit 1
            ;;
        recovery-blocked)
            log "startup: interrupted mutation has no last-successful recovery target"
            record_run_status 1 "${interrupted_sha:-unknown}"
            record_run_summary 1 "startup" "recovery-blocked" "${interrupted_sha:-unknown}"
            exit 1
            ;;
        recover-last-successful | verify-committed)
            log "startup: ${startup_action}"
            if ! recover_last_successful "$host" "$interrupted_sha" "true"; then
                return_to_branch
                record_run_status 1 "${interrupted_sha:-unknown}"
                record_run_summary 1 "recovery" "failure" "${interrupted_sha:-unknown}" "true"
                exit 1
            fi
            return_to_branch
            RECOVERED_LAST_SUCCESSFUL=1
            ;;
        normal) ;;
        *) die "unknown startup action: ${startup_action}" ;;
    esac

    validate_host "$host"

    FAST_DEADLINE_SECONDS="$((RUN_STARTED_SECONDS + 60))"
    local fetch_available=1 target_sha current_sha failed_sha suppressed=0
    if ! do_fetch; then
        fetch_available=0
        log "fetch: unavailable; auditing retained last-successful state"
    fi

    last_sha="$(read_last_good_sha)"
    failed_sha="$(read_failed_target_sha)"
    if [[ "$fetch_available" == "1" ]]; then
        target_sha="$(git rev-parse "${ABHAILE_REMOTE}/${ABHAILE_BRANCH}")"
    else
        target_sha="$last_sha"
    fi
    current_sha="$(git rev-parse HEAD)"
    log "detect: current=${current_sha:0:12} target=${target_sha:0:12} last-good=${last_sha:0:12}"

    if [[ "$fetch_available" == "1" && "$RECOVERED_LAST_SUCCESSFUL" == "1" \
        && "$target_sha" == "$last_sha" ]]; then
        RUN_TRIGGER="recovery"
        log "detect: target already reconciled during startup recovery"
        if [[ -n "$failed_sha" ]]; then
            state_call clear_matching_failed_target "$failed_sha"
        fi
        record_run_status 0 "$target_sha"
        record_run_summary 0 "complete" "recovery-success" "$target_sha" "true"
        return_to_branch
        exit 0
    fi

    if [[ "$fetch_available" == "1" && "$ABHAILE_FORCE_RETRY" != "1" \
        && -n "$failed_sha" && "$failed_sha" == "$target_sha" ]]; then
        suppressed=1
        log "detect: suppressing retry of failed commit ${target_sha:0:12}; auditing last-successful"
        target_sha="$last_sha"
    fi

    local decision prior_postcheck full_reason="" success_outcome=""
    load_full_schedule "$target_sha"
    decision="$SCHEDULE_DECISION"
    prior_postcheck="$SCHEDULE_POSTCHECK"

    if [[ "$fetch_available" == "1" && "$suppressed" != "1" \
        && "$target_sha" != "$last_sha" ]]; then
        full_reason="new-commit"
        success_outcome="full-new-commit"
        RUN_TRIGGER="new-commit"
    elif [[ "$decision" == "due" ]]; then
        full_reason="$RUN_TRIGGER"
        if [[ "$RUN_TRIGGER" == "forced" ]]; then
            success_outcome="full-forced"
        elif [[ "$fetch_available" == "1" ]]; then
            success_outcome="full-periodic"
        else
            success_outcome="full-periodic-offline"
        fi
    fi

    if [[ -z "$full_reason" ]]; then
        local audit_root="${RUN_CONTEXT_DIR}/audit"
        git checkout --quiet "$target_sha"
        validate_host "$host"
        if ! do_render_bounded "$host" "$audit_root"; then
            full_reason="integrity-drift"
            success_outcome="full-integrity-drift"
            RUN_TRIGGER="render-uncertainty"
        elif ! do_integrity "$host" "$audit_root" enrollment-foundations; then
            log "fast-path: enrollment foundations require bootstrap or adoption"
            record_run_status 1 "$target_sha"
            record_run_summary 1 "fast-path" "degraded-enrollment-foundation" "$target_sha" "false"
            return_to_branch
            exit 1
        elif ! do_integrity "$host" "$audit_root" ordinary; then
            full_reason="integrity-drift"
            success_outcome="full-integrity-drift"
            RUN_TRIGGER="integrity-drift"
        elif ! do_actionable_health "$audit_root"; then
            full_reason="actionable-health"
            success_outcome="full-actionable-health"
            RUN_TRIGGER="actionable-health"
        else
            if [[ "$suppressed" == "1" ]]; then
                RUN_TRIGGER="failed-target"
                record_run_status 1 "$failed_sha"
                record_run_summary 1 "fast-path" "failed-target-suppressed" "$failed_sha" "false"
                return_to_branch
                exit 1
            fi
            if [[ "$fetch_available" == "1" ]]; then
                finish_fast_result "$target_sha" "fast-clean" || exit $?
            else
                finish_fast_result "$target_sha" "fast-offline-clean" || exit $?
            fi
            exit 0
        fi

        if [[ "$RUN_TRIGGER" =~ ^(integrity-drift|actionable-health)$ \
            && "$prior_postcheck" == "degraded" \
            && "$ABHAILE_FORCE_FULL" != "1" ]]; then
            if degraded_repair_is_deferred "audit audit ${RUN_FULL_INTERVAL} ${RUN_INTERVAL_STATUS} ${RUN_LAST_FULL_AGE} degraded"; then
                log "fast-path: degraded repair deferred until the one-hour retry boundary"
                RUN_POST_FULL_OUTCOME="degraded-repair-deferred"
                if [[ "$suppressed" == "1" ]]; then
                    RUN_TRIGGER="failed-target"
                    record_run_status 1 "$failed_sha"
                    record_run_summary 1 "fast-path" "failed-target-suppressed" \
                        "$failed_sha" "false"
                else
                    record_run_status 1 "$target_sha"
                    record_run_summary 1 "fast-path" "degraded-repair-deferred" \
                        "$target_sha" "false"
                fi
                return_to_branch
                exit 1
            fi
        fi
    fi

    local previous_manifest="" candidate_root="${RUN_CONTEXT_DIR}/candidate"
    if [[ "$target_sha" != "$last_sha" ]]; then
        local previous_root="${RUN_CONTEXT_DIR}/previous-last-successful"
        log "removal-context: rendering last-successful ${last_sha:0:12}"
        git checkout --quiet "$last_sha"
        validate_host "$host"
        if ! do_render "$host" "$previous_root"; then
            return_to_branch
            record_run_status 1 "$target_sha"
            record_run_summary 1 "render" "last-successful-context-failure" "$target_sha" "false"
            exit 1
        fi
        previous_manifest="${previous_root}/rendered/manifest.json"
        git checkout --quiet "$ABHAILE_BRANCH"
        do_checkout "$target_sha"
    else
        git checkout --quiet "$target_sha"
    fi

    if run_pipeline_for_checked_out_commit "$host" "$target_sha" "$candidate_root" \
        "${candidate_root}/rendered/manifest.json" "$previous_manifest"; then
        log "success: full reconciliation applied commit ${target_sha:0:12}"
        if [[ "$target_sha" == "$last_sha" ]]; then
            commit_success "$target_sha" "false"
        else
            commit_success "$target_sha" "true"
        fi
        local completed_full_status=0
        record_completed_full "$host" "$target_sha" "$candidate_root" "$success_outcome" \
            || completed_full_status=$?
        if [[ "$suppressed" == "1" ]]; then
            RUN_TRIGGER="failed-target"
            record_run_status 1 "$failed_sha"
            record_run_summary 1 "fast-path" "failed-target-suppressed" "$failed_sha" "false"
            return_to_branch
            exit 1
        fi
        if [[ "$completed_full_status" == "0" ]]; then
            return_to_branch
            exit 0
        fi
        return_to_branch
        exit 1
    fi

    local failed_phase
    failed_phase="$(read_current_phase || true)"
    if [[ "$target_sha" == "$last_sha" ]]; then
        log "accepted-state full pipeline failed at ${target_sha:0:12}"
        if [[ "$(read_current_run_sha)" == "$target_sha" ]] \
            && recover_last_successful "$host" "$target_sha" "true"; then
            return_to_branch
            record_run_status 1 "$target_sha"
            record_run_summary 1 "${failed_phase:-apply}" "failure-recovered" "$target_sha" "true"
            exit 1
        fi
        return_to_branch
        record_run_status 1 "$target_sha"
        record_run_summary 1 "${failed_phase:-preflight}" "failure-before-mutation" "$target_sha" "false"
        exit 1
    fi

    record_failed_target "$target_sha"
    if [[ "$(read_current_run_sha)" != "$target_sha" ]]; then
        log "pipeline failed before managed-state mutation; recovery is not required"
        return_to_branch
        record_run_status 1 "$target_sha"
        record_run_summary 1 "${failed_phase:-preflight}" "failure-before-mutation" "$target_sha" "false"
        exit 1
    fi
    log "pipeline failed at ${target_sha:0:12}; reconciling last-successful"
    if recover_last_successful "$host" "$target_sha" "true"; then
        return_to_branch
        record_run_status 1 "$target_sha"
        record_run_summary 1 "${failed_phase:-apply}" "failure-recovered" "$target_sha" "true"
        exit 1
    fi
    return_to_branch
    record_run_status 1 "$target_sha"
    record_run_summary 1 "recovery" "failure" "$target_sha" "true"
    exit 1
}

main "$@"

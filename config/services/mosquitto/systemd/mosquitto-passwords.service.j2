[Unit]
Description=Refresh Mosquitto password hashes from Vault Agent
Wants=network-online.target
After=network-online.target abhaile-secrets-ready.service
Requires=abhaile-secrets-ready.service

[Service]
Type=oneshot
UMask=0077
Environment=PYTHONPATH=/opt/abhaile/src
ExecStart=/opt/abhaile/.venv/bin/python -m abhaile.cli.mosquitto_passwords --source /srv/vault/agent/out/mosquitto-accounts.json --destination /srv/mosquitto/secrets/passwords --image {{ service.config.image }}

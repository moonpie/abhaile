[Unit]
Description=Install CoreDNS (Omada build) to /usr/local/bin
After=network-online.target coredns-omada-build.service
Requires=coredns-omada-build.service
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/podman run --rm --pull=never --entrypoint=/bin/sh -v /usr/local/bin:/out:Z localhost/coredns-omada:latest -c 'set -eu; tmp=$$(mktemp /out/.coredns.XXXXXX); trap "rm -f -- $$tmp" EXIT; cp /coredns "$$tmp"; chmod 0755 "$$tmp"; mv -f -- "$$tmp" /out/coredns'

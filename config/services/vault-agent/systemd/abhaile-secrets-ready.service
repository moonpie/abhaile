[Unit]
Description=Abhaile secrets/templates are rendered (global gate)

[Service]
Type=oneshot
ExecStart=/bin/sh -eu -c 'sentinel=/srv/vault/agent/out/.ready; test -s "$sentinel" || { echo "missing or empty $sentinel"; exit 1; }; uptime=$$(cut -d. -f1 /proc/uptime); boot_epoch=$$(($$(date +%%s) - uptime)); mtime=$$(stat -c %%Y "$sentinel"); if [ "$mtime" -lt "$boot_epoch" ]; then echo "stale $sentinel from before current boot"; rm -f "$sentinel"; exit 1; fi'
RemainAfterExit=yes
